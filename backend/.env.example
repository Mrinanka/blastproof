# Copy to backend/.env (git-ignored). Each build step adds the variables it uses (backend plan §11).
APP_ENV=local
LOG_LEVEL=INFO

# Step 3: loading the fake company database into Neon (demo_company/seed.py --target neon).
# Dev project (blastproof-company-dev) only; never put blastproof-company values here (D-054).
# Owner role on the DIRECT endpoint (no -pooler), used only by seed.py and rebase_dates.py.
SEED_NEON_OWNER_URL=
# The backend's company-database logins. seed.py creates these roles with SQL (D-077) using the
# passwords in these URLs; Neon needs at least 60 bits of entropy per password.
# From step 6 the backend reads through COMPANY_DB_READER_URL: the direct endpoint (no -pooler),
# sslmode=require and no channel_binding (asyncpg would send it to Postgres as a setting; refused).
COMPANY_DB_READER_URL=
COMPANY_DB_WRITER_URL=

# Step 4: Alembic migrations run as blastproof_owner (plain postgresql:// URL: psycopg 3, the
# SQLAlchemy 2.1 default). Never used by the running app. This is the throwaway local Compose value.
BLASTPROOF_MIGRATOR_URL=postgresql://blastproof_owner:blastproof_owner@localhost:5432/blastproof

# Step 5: the running app's database login, as blastproof_app (SQLAlchemy asyncpg URL). This is the
# throwaway local Compose value. On Neon (production): the direct endpoint (no -pooler) and no
# channel_binding parameter; asyncpg would send it to Postgres as a setting.
BLASTPROOF_DATABASE_URL=postgresql+asyncpg://blastproof_app:blastproof_app@localhost:5432/blastproof
# Signs dashboard login tokens: at least 32 bytes. Generate one with
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Step 6: the MCP server. The backend's public address: its host passes the MCP DNS-rebinding
# check, and step 19 builds agents' mcp_url from it. On Fly: https://<app>.fly.dev
PUBLIC_BASE_URL=http://localhost:8000
# Which company database reads go to: neon (COMPANY_DB_READER_URL above, the default and the only
# choice in production) or local (the Compose company-db, LOCAL_COMPANY_READER_URL below).
COMPANY_CONNECTION_PROFILE=neon
# The local profile's reader login. This is the throwaway local Compose value.
LOCAL_COMPANY_READER_URL=postgresql://blastproof_reader:blastproof_reader@localhost:5433/company_main
# Stored on the "company" system row, and used by the Neon client (step 10).
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=

# Step 10: shadow runs (a copy of the company database per write). COMPANY_DB_WRITER_URL above is the
# writer login for Neon branches (direct endpoint, no channel_binding); its password is the only
# one the backend needs for the branch. NEON_API_KEY is the project-scoped key of the same project.
NEON_API_KEY=
# api = real Neon branches (default and the only choice in production); fake = local clones (CI).
NEON_CLIENT=
# Only for the local profile and CI: clone company_main on the Compose company-db.
# These are the throwaway local Compose values:
#   LOCAL_COMPANY_WRITER_URL=postgresql://blastproof_writer:blastproof_writer@localhost:5433/company_main
#   FAKE_NEON_ADMIN_URL=postgresql://company:company@localhost:5433/postgres
LOCAL_COMPANY_WRITER_URL=
FAKE_NEON_ADMIN_URL=

# Step 9: optional. Path to the write rules; the default is policies/rules.yaml.
# POLICY_FILE=

# Step 11: knowledge and RAG. All optional; an empty value means the default.
# The embedding model (fastembed). Its vectors must have 384 dimensions.
EMBEDDING_MODEL=
# Where the model is downloaded once (default: backend/.cache/fastembed).
EMBEDDING_CACHE_DIR=
# Where vectors live. Only pgvector exists for now.
VECTOR_STORE=

# Step 12: the impact summary. Empty values mean the defaults.
# Any provider:model string for LangChain's init_chat_model (default google_genai:gemini-3.8-flash).
SUMMARY_MODEL=
# Extra constructor arguments for that model, as a JSON object. Never logged. Gemini 3.8 Flash
# thinks at "medium" by default and thinking tokens count against LLM_MAX_TOKENS, so use "low".
# Keep the single quotes: `uv run --env-file` cannot parse unquoted JSON.
SUMMARY_MODEL_OPTIONS='{"thinking_level": "low"}'
# Price per million tokens per model, as JSON; a value replaces the whole default table, and the
# summary model must be in it or the app does not start. Default (until 2026-12-31):
#   LLM_PRICES='{"google_genai:gemini-3.8-flash": {"input_per_million": 0.75, "output_per_million": 3.75}}'
# From 2027-01-01 Gemini 3.8 Flash costs 1.50 / 7.50: set that here.
LLM_PRICES=
# The model's key. LangChain reads it from the process environment, not from Settings, so start
# the backend with `uv run uvicorn app.main:app --reload --env-file .env --log-config log_config.json`
# (and the CLI with `uv run --env-file .env python -m app.cli ...`) to put .env into the environment.
GOOGLE_API_KEY=
