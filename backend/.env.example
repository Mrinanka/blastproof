# Copy to backend/.env (git-ignored). Each build step adds the variables it uses (backend plan §11).
APP_ENV=local
LOG_LEVEL=INFO

# Step 3: loading the fake company database into Neon (demo_company/seed.py --target neon).
# Dev project (blastproof-company-dev) only; never put blastproof-company values here (D-054).
# Owner role on the DIRECT endpoint (no -pooler), used only by seed.py and rebase_dates.py.
SEED_NEON_OWNER_URL=
# The backend's company-database logins. seed.py creates these roles with SQL (D-077) using the
# passwords in these URLs; Neon needs at least 60 bits of entropy per password.
# From step 6 the backend reads through COMPANY_DB_READER_URL: the direct endpoint (no -pooler),
# sslmode=require and no channel_binding (asyncpg would send it to Postgres as a setting; refused).
COMPANY_DB_READER_URL=
COMPANY_DB_WRITER_URL=

# Step 4: Alembic migrations run as blastproof_owner (plain postgresql:// URL: psycopg 3, the
# SQLAlchemy 2.1 default). Never used by the running app. This is the throwaway local Compose value.
BLASTPROOF_MIGRATOR_URL=postgresql://blastproof_owner:blastproof_owner@localhost:5432/blastproof

# Step 5: the running app's database login, as blastproof_app (SQLAlchemy asyncpg URL). This is the
# throwaway local Compose value. On Neon (production): the direct endpoint (no -pooler) and no
# channel_binding parameter; asyncpg would send it to Postgres as a setting.
BLASTPROOF_DATABASE_URL=postgresql+asyncpg://blastproof_app:blastproof_app@localhost:5432/blastproof
# Signs dashboard login tokens: at least 32 bytes. Generate one with
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Step 6: the MCP server. The backend's public address: its host passes the MCP DNS-rebinding
# check, and step 19 builds agents' mcp_url from it. On Fly: https://<app>.fly.dev
PUBLIC_BASE_URL=http://localhost:8000
# Which company database reads go to: neon (COMPANY_DB_READER_URL above, the default and the only
# choice in production) or local (the Compose company-db, LOCAL_COMPANY_READER_URL below).
COMPANY_CONNECTION_PROFILE=neon
# The local profile's reader login. This is the throwaway local Compose value.
LOCAL_COMPANY_READER_URL=postgresql://blastproof_reader:blastproof_reader@localhost:5433/company_main
# Stored on the "company" system row (step 10's Neon client uses them).
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=

# Step 9: optional. Path to the write rules; the default is policies/rules.yaml.
# POLICY_FILE=
