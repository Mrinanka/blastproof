{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Edit|Write|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/python",
            "args": ["/path/to/blastproof/claude_hook/pre_tool_use.py", "--url", "http://localhost:8000"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
